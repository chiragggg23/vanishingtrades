# --- required in production -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Local MongoDB or Atlas, e.g. mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/vanishingtrades
MONGODB_URI=mongodb://127.0.0.1:27017/vanishingtrades
# Long random string. The server refuses to start in production without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# Comma-separated extra origins allowed by CORS (localhost:5173 and :4173 are always allowed)
CORS_ORIGINS=https://your-app.vercel.app

# --- demo world -----------------------------------------------------------------------------------
# true: GET /api/demo reports demo mode, POST /api/demo/reset re-seeds, an empty DB seeds itself on start
DEMO_MODE=true
# false: seeded accounts get random unusable passwords (use for a public production database)
SEED_DEMO_ACCOUNTS=true
# Used only when SEED_DEMO_ACCOUNTS=false: creates a real admin during "npm run seed"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- uploads: Cloudinary free tier (optional; without it files go to server/uploads) --------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI: "mock" (default, deterministic sample output) or "groq" (free tier, real output) --------
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_SPEECH_MODEL=whisper-large-v3
AI_TIMEOUT_MS=25000

# --- misc -------------------------------------------------------------------------------------------
BCRYPT_ROUNDS=10
RATE_LIMIT_DISABLED=false
